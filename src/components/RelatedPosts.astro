---
const {
  posts = [],
  title = "Konten Terkait",
  baseUrl = ""
} = Astro.props;

const isTools = baseUrl === "/tools";

---

{
  posts.length > 0 && (
    <section class="related-posts">

      <h2>{title}</h2>

      <div class="related-grid">

        {posts.map((post) => (

          <article class="related-card">

            <a href={`${baseUrl}/${post.slug}/`}>
{!isTools && (
              <img
                src={
                  post.data.image
                    ? post.data.image
                    : `/api/og/${post.slug}.svg`
                }
                alt={post.data.title}
                loading="lazy"
              />
)}
              <h3>{post.data.title}</h3>

              {post.data.description && (
                <p>{post.data.description}</p>
              )}

            </a>

          </article>

        ))}

      </div>

    </section>
  )
}

<style is:global>
.related-posts {
  width: 100%;
  margin-top: 50px;
}

.related-posts h2 {
  margin: 0 0 20px;
  font-size: 24px;
}

.related-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 20px;
}

.related-card {
  overflow: hidden;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 18px;
  box-shadow: var(--shadow);
  transition: transform .2s;
}

.related-card:hover {
  transform: translateY(-3px);
}

.related-card a {
  display: block;
  color: inherit;
  text-decoration: none;
}

.related-card img {
  display: block;
  width: 100%;
  aspect-ratio: 1200 / 630;
  object-fit: cover;
}

.related-card h3 {
  margin: 0;
  padding: 14px 16px 6px;
  font-size: 16px;
  line-height: 1.5;
}

.related-card p {
  margin: 0;
  padding: 0 16px 16px;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.6;
}

@media (max-width: 768px) {
  .related-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .related-card h3 {
    padding: 10px 12px 4px;
    font-size: 14px;
  }

  .related-card p {
    padding: 0 12px 12px;
    font-size: 12px;
  }
}

@media (max-width: 480px) {
  .related-grid {
    grid-template-columns: 1fr;
  }
}
</style>
