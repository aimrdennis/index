---
import { SITE } from "../lib/site";
import { getCollection } from "astro:content";

let posts = await getCollection("blog");

// Latest Posts
const latestPosts = [...posts]
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
  .slice(0, 4);

// Popular Posts
const popularPosts = [...posts]
  .filter((post) => post.data.popular)
  .slice(0, 4);
---

<!-- FOOTER -->
<footer class="footer-modern">
  <div class="container">

   <div class="footer-grid">

  <!-- LATEST -->
  <div class="footer-links">
    <h4>Latest Posts</h4>

    {latestPosts.map((post) => (
      <a href={`/blog/${post.slug}/`}>
        {post.data.title}
      </a>
    ))}
  </div>

  <!-- POPULAR -->
  <div class="footer-links">
    <h4>Popular Posts</h4>

    {popularPosts.map((post) => (
      <a href={`/blog/${post.slug}/`}>
        {post.data.title}
      </a>
    ))}
  </div>

  <!-- COMPANY + SOCIAL -->
  <div class="footer-service">

    <div class="footer-col">
      <h4>Company</h4>

      <a href="/about">About</a>
      <a href="/services">Services</a>
      <a href="/pricing">Pricing</a>
      <a href="/contact">Contact</a>
    </div>

    <div class="footer-col">
      <h4>Social</h4>

      <a href="#">Instagram</a>
      <a href="#">Telegram</a>
      <a href="#">Facebook</a>
      <a href="#">Pinterest</a>
    </div>

  </div>

  <!-- ABOUT -->
  <div class="footer-about">
    <h4>About</h4>

    <p>
      AI Mr Dennis adalah AI developer Indonesia yang membangun aplikasi modern,
      sistem automation, dan solusi digital berbasis AI untuk sukses.
    </p>

    <p>Jakarta, Indonesia</p>
    <p>hello@aimrdennis.com</p>
  </div>

</div>

   

    </div>

    <div class="footer-bottom">
      <p>
        © {new Date().getFullYear()} {SITE.name}
      </p>
    </div>

  </div>
</footer>



<style>
/* =========================
   FOOTER MODERN (FINAL CLEAN)
========================= */

.footer-modern {
  padding: 80px 0 26px;
  border-top: 1px solid var(--border);

  background: linear-gradient(
    180deg,
    rgba(20, 24, 34, 0.96),
    rgba(12, 15, 22, 1)
  );
}

/* CONTAINER */
.footer-modern .container {
  width: 100%;
  max-width: 1200px;
  margin: auto;
  padding: 0 20px;
  box-sizing: border-box;
}

/* GRID */
.footer-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 40px;
  align-items: start;
}

/* FIX OVERFLOW */
.footer-grid > * {
  min-width: 0;
}

/* =========================
   ABOUT
========================= */

.footer-about h4 {
  font-size: 18px;
  margin-bottom: 16px;
  color: #fff;
}

.footer-about p {
  color: var(--soft);
  font-size: 15px;
  line-height: 1.9;
  margin-bottom: 14px;
  overflow-wrap: break-word;
}

/* =========================
   HEADINGS
========================= */

.footer-links h4,
.footer-service h4 {
  font-size: 18px;
  margin-bottom: 18px;
  color: #fff;
}

/* =========================
   LINKS
========================= */

.footer-links a,
.footer-service a {
  display: block;
  color: var(--soft);
  text-decoration: none;

  font-size: 15px;
  line-height: 1.7;

  margin-bottom: 12px;

  transition: 0.25s ease;
}

/* hover */
.footer-links a:hover,
.footer-service a:hover {
  color: #fff;
  transform: translateX(4px);
}

/* =========================
   COMPANY + SOCIAL
========================= */

.footer-service {
  display: grid;
  grid-template-columns: 1fr;
  gap: 30px;
}

.footer-col h4 {
  margin-bottom: 14px;
}

.footer-col a {
  display: block;
  margin-bottom: 10px;
}

/* =========================
   FOOTER BOTTOM
========================= */

.footer-bottom {
  margin-top: 70px;
  padding-top: 26px;

  border-top: 1px solid rgba(255, 255, 255, 0.08);

  text-align: center;
  color: var(--soft);
  font-size: 14px;
}

/* =========================
   TABLET
========================= */

@media (max-width: 1024px) {
  .footer-grid {
    grid-template-columns: 1fr 1fr;
    gap: 40px 30px;
  }
}

/* =========================
   MOBILE
========================= */

@media (max-width: 640px) {
  .footer-modern {
    padding: 60px 0 24px;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 36px;
  }

  /* Company + Social jadi 2 kolom */
  .footer-service {
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .footer-about p,
  .footer-links a,
  .footer-service a {
    font-size: 14px;
  }

  .footer-bottom {
    margin-top: 50px;
    font-size: 13px;
  }
}

</style>

