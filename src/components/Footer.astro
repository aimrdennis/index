---
import { SITE } from "../lib/site";
import { getCollection } from "astro:content";

let posts = await getCollection("blog");

// Latest Posts
const latestPosts = [...posts]
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
  .slice(0, 3);

// Popular Posts
const popularPosts = [...posts]
  .filter((post) => post.data.popular)
  .slice(0, 3);
---

<!-- FOOTER -->
<footer class="footer-modern">
  <div class="container">

    <div class="footer-grid">

      <!-- ABOUT -->
      <div class="footer-about">
        <h3>AIMRDENNIS.COM</h3>

        <p>
          AI Mr Dennis adalah AI developer Indonesia yang membangun aplikasi modern, sistem automation, dan solusi digital berbasis AI untuk sukses.
        </p>

        <p>Jakarta, Indonesia</p>

        <p>hello@aimrdennis.com</p>
      </div>

   <!-- COMPANY -->
      <div class="footer-service">
        <h4>Company</h4>

        <a href="/about">About</a>
        <a href="/services">Services</a>
        <a href="/pricing">Pricing</a>
        <a href="/contact">Contact</a>
        <h4>Social</h4>

        <a href="#">Instagram</a>
        <a href="#">Telegram</a>
        <a href="#">Facebook</a>
        <a href="#">Pinterest</a>
      </div>



      <!-- LATEST POSTS -->
      <div class="footer-links">
        <h4>Latest Posts</h4>

        {
          latestPosts.map((post) => (
            <a href={`/blog/${post.slug}/`}>
              {post.data.title}
            </a>
          ))
        }
      </div>

      <!-- POPULAR POSTS -->
      <div class="footer-links">
        <h4>Popular Posts</h4>

        {
          popularPosts.map((post) => (
            <a href={`/blog/${post.slug}/`}>
              {post.data.title}
            </a>
          ))
        }
      </div>

   

    </div>

    <div class="footer-bottom">
      <p>
        © {new Date().getFullYear()} {SITE.name}
      </p>
    </div>

  </div>
</footer>
