---
import { SITE } from "../lib/site";
import { getCollection } from "astro:content";

let posts = await getCollection("blog");

// Latest Posts
const latestPosts = [...posts]
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
  .slice(0, 4);

// Popular Posts
const popularPosts = [...posts]
  .filter((post) => post.data.popular)
  .slice(0, 4);
---

<!-- FOOTER -->
<footer class="footer-modern">
  <div class="container">

   <div class="footer-grid">

  <!-- LATEST -->
  <div class="footer-links">
    <h4>Latest Posts</h4>

    {latestPosts.map((post) => (
      <a href={`/blog/${post.slug}/`}>
        {post.data.title}
      </a>
    ))}
  </div>

  <!-- POPULAR -->
  <div class="footer-links">
    <h4>Popular Posts</h4>

    {popularPosts.map((post) => (
      <a href={`/blog/${post.slug}/`}>
        {post.data.title}
      </a>
    ))}
  </div>

  <!-- COMPANY + SOCIAL -->
  <div class="footer-service">

    <div class="footer-col">
      <h4>Company</h4>

      <a href="/about">About</a>
      <a href="/services">Services</a>
      <a href="/pricing">Pricing</a>
      <a href="/contact">Contact</a>
    </div>

    <div class="footer-col">
      <h4>Social</h4>

      <a href="#">Instagram</a>
      <a href="#">Telegram</a>
      <a href="#">Facebook</a>
      <a href="#">Pinterest</a>
    </div>

  </div>

  <!-- ABOUT -->
  <div class="footer-about">
    <h4>About</h4>

    <p>
      AI Mr Dennis adalah AI developer Indonesia yang membangun aplikasi modern,
      sistem automation, dan solusi digital berbasis AI untuk sukses.
    </p>

    <p>Jakarta, Indonesia</p>
    <p>hello@aimrdennis.com</p>
  </div>

</div>

   

    </div>

    <div class="footer-bottom">
      <p>
        © {new Date().getFullYear()} {SITE.name}
      </p>
    </div>

  </div>
</footer>



<style>
.footer-modern {
  padding: 80px 0 26px;
  border-top: 1px solid var(--border);
  background: linear-gradient(180deg, rgba(20,24,34,.96), rgba(12,15,22,1));
}

/* container */
.footer-modern .container {
  max-width: var(--container);
  margin: auto;
  padding: 0 20px;
}

/* ⭐ FIX UTAMA DI SINI */
.footer-grid {
  display: grid;

  /* PROPORTIONAL LAYOUT (INI FIX OVERFLOW) */
  grid-template-columns: 1.4fr 1.4fr 0.8fr 1fr;

  gap: 40px;
  align-items: start;
}

/* prevent shrink issue */
.footer-grid > * {
  min-width: 0;
}

/* ABOUT */
.footer-about h4 {
  font-size: 18px;
  margin-bottom: 16px;
  color: #fff;
}

.footer-about p {
  color: var(--text-soft);
  font-size: 15px;
  line-height: 1.9;
  margin-bottom: 12px;
}

/* HEADINGS */
.footer-links h4,
.footer-service h4 {
  font-size: 18px;
  margin-bottom: 18px;
  color: #fff;
}

/* LINKS */
.footer-links a,
.footer-service a {
  display: block;
  color: var(--text-soft);
  font-size: 15px;
  line-height: 1.7;
  margin-bottom: 12px;
  transition: .25s ease;
}

.footer-links a:hover,
.footer-service a:hover {
  color: #fff;
  transform: translateX(4px);
}

/* SERVICE GRID (IMPORTANT FIX) */
.footer-service {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28px;
}

/* COLUMN INTERNAL */
.footer-col a {
  margin-bottom: 10px;
}

/* FOOTER BOTTOM */
.footer-bottom {
  margin-top: 70px;
  padding-top: 26px;
  border-top: 1px solid rgba(255,255,255,.08);
  text-align: center;
  color: var(--text-soft);
  font-size: 14px;
}

/* TABLET */
@media (max-width: 1024px) {
  .footer-grid {
    grid-template-columns: 1fr 1fr;
    gap: 40px 30px;
  }
}

/* MOBILE */
@media (max-width: 640px) {
  .footer-grid {
    grid-template-columns: 1fr;
  }

  .footer-service {
    grid-template-columns: 1fr 1fr;
  }
}
</style>

