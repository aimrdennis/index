---
import "../styles/global.css";
import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { generateFaqSchema } from "../lib/faq-schema";

const {
  title,
  description,
  canonical,
  html = "",
  articleSchema,
  breadcrumbs,
  amp
} = Astro.props;

const faqSchema = generateFaqSchema(html);



---

<!doctype html>
<html lang="id">
<head>
  <SeoHead
    title={title}
    description={description}
    canonical={canonical}
    articleSchema={articleSchema}
    breadcrumbs={breadcrumbs}
    faqSchema={faqSchema}
    amp={amp}
  />
  <link rel="stylesheet" href="/styles/global.css" />
<script is:inline>
  if (localStorage.getItem("theme") === "light") {
    document.documentElement.classList.add("light-mode");
  }
</script>
</head>

<body>


<!-- HEADER -->

<header class="main-header">

<div class="container">

<div class="header-wrap">

<div class="left-nav">

<div class="menu-btn" onclick="openMenu()">
☰
</div>

<a href="/" class="logo">
AI MR DENNIS
</a>

</div>

<nav class="desktop-nav">

<a href="/">Home</a>
<a href="/blog">Blog</a>
<a href="/about">Portfolio</a>
<a href="/contact">Contact</a>

</nav>

<div class="right-nav">

  <button
    class="theme-btn"
    onclick="toggleTheme()"
  >

    <!-- MOON -->

    <svg
      class="moon-icon"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
    >
      <path
        d="M21 12.79A9 9 0 1111.21 3
        7 7 0 0021 12.79z"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>

    <!-- SUN -->

    <svg
      class="sun-icon"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
    >
      <circle
        cx="12"
        cy="12"
        r="5"
        stroke="currentColor"
        stroke-width="2"
      />

      <path
        d="M12 1v2
        M12 21v2
        M4.22 4.22l1.42 1.42
        M18.36 18.36l1.42 1.42
        M1 12h2
        M21 12h2
        M4.22 19.78l1.42-1.42
        M18.36 5.64l1.42-1.42"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
    </svg>

  </button>

</div>

</div>

</div>

</header>

<!-- MOBILE MENU -->

<div class="mobile-menu" id="mobileMenu">

<div class="close-btn" onclick="closeMenu()">
✕
</div>

<div class="mobile-nav">

<a href="#">Home</a>
<a href="#">About</a>
<a href="#">Services</a>
<a href="#">Pricing</a>
<a href="#">Portfolio</a>
<a href="#">Blog</a>
<a href="#">FAQ</a>
<a href="#">Contact</a>

</div>

<div class="mobile-contact">

<p>Jakarta, Indonesia</p>
<p>hello@yoursite.com</p>
<p>+62 812 0000 0000</p>

</div>

<div class="mobile-social">

<a href="#">Instagram</a>
<a href="#">Telegram</a>
<a href="#">Facebook</a>
<a href="#">Pinterest</a>

</div>

  <main>
    <slot />
  </main>

  <Footer />


<script is:inline>
  window.toggleTheme = function () {
    const html = document.documentElement;

    html.classList.toggle("light-mode");

    localStorage.setItem(
      "theme",
      html.classList.contains("light-mode") ? "light" : "dark"
    );
  };

  if (localStorage.getItem("theme") === "light") {
    document.documentElement.classList.add("light-mode");
  }
</script>

<script is:inline>

function openMenu(){
  document
    .getElementById("mobileMenu")
    .classList.add("active");
}

function closeMenu(){
  document
    .getElementById("mobileMenu")
    .classList.remove("active");
}


/* FAQ */

const faqItems =
  document.querySelectorAll(".faq-item");

faqItems.forEach(item=>{

  item
    .querySelector(".faq-question")
    .addEventListener("click",()=>{

      item.classList.toggle("active");

    });

});

</script>

</body>
</html>
