---
import MainLayout from "../../../layouts/MainLayout.astro";

/* =========================================================
   CATEGORY
   ========================================================= */

export async function getStaticPaths() {
  const modules = import.meta.glob(
    "../**/*.astro",
    { eager: true }
  );

  const categories = new Set();

  for (const file of Object.keys(modules)) {
    const match = file.match(
      /^\.\.\/([^/]+)\/(.+)\.astro$/
    );

    if (!match) continue;

    const category = match[1];

    if (category === "[category]") continue;

    categories.add(category);
  }

  return [...categories].map((category) => ({
    params: { category }
  }));
}

const category = Astro.params.category || "";

const categoryName = category
  .replace(/[-_]/g, " ")
  .replace(/\b\w/g, (char) => char.toUpperCase());


/* =========================================================
   TOOLS
   ========================================================= */

const modules = Object.entries(
  import.meta.glob(
    "../**/*.astro",
    { eager: true }
  )
);

const tools = modules
  .map(([file, mod]) => {
    const match = file.match(
      /^\.\.\/([^/]+)\/(.+)\.astro$/
    );

    if (!match) return null;

    const fileCategory = match[1];
    const toolPath = match[2];

    if (
      fileCategory.toLowerCase() !==
      category.toLowerCase()
    ) {
      return null;
    }

    if (toolPath === "index") return null;

    if (!mod.meta) return null;

    return {
      ...mod.meta,
      url: `/tools/${category}/${toolPath}/`
    };
  })
  .filter(Boolean)
  .sort((a, b) =>
    (a.title || "").localeCompare(
      b.title || ""
    )
  );


/* =========================================================
   FEATURED
   ========================================================= */

const featured = tools.filter(
  (tool) => tool.featured
);

const total = tools.length;


/* =========================================================
   SEO
   ========================================================= */

const siteUrl = "https://aimrdennis.biz";

const pageUrl =
  `${siteUrl}/tools/${category}/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",

  name:
    `${categoryName} Tools Online Gratis`,

  url: pageUrl,

  numberOfItems: total,

  itemListElement: tools.map(
    (tool, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: tool.title,
      url:
        `${siteUrl}${tool.url}`
    })
  )
};
---

<MainLayout
  title={`${categoryName} Tools Online Gratis | AI Mr Dennis`}
  description={`Kumpulan ${categoryName.toLowerCase()} tools online gratis yang dapat digunakan langsung dari browser.`}
  pageCSS={["tools"]}
>

  <main class="tools-page">

    <!-- HERO -->
    <header class="tools-header">

      <span class="tools-label">
        {categoryName.toUpperCase()} TOOLS
      </span>

      <h1>
        {categoryName} Tools Online Gratis
      </h1>

      <p>
        Kumpulan {categoryName.toLowerCase()}
        tools online gratis yang dapat digunakan
        langsung dari browser.
      </p>

    </header>


    <!-- STATS -->
    <section class="tools-stats">

      <div>
        <strong>{total}</strong>
        <span>Tools</span>
      </div>

      <div>
        <strong>100%</strong>
        <span>Gratis</span>
      </div>

      <div>
        <strong>Fast</strong>
        <span>No Login</span>
      </div>

    </section>


    <!-- SEARCH -->
    <div class="tools-search">

      <input
        id="toolSearch"
        type="search"
        placeholder={`Cari ${categoryName.toLowerCase()} tools...`}
        autocomplete="off"
      />

    </div>


    <!-- FEATURED -->
    {featured.length > 0 && (

      <section class="tools-section">

        <h2 class="section-title">
          🔥 Popular {categoryName} Tools
        </h2>

        <div class="tools-grid">

          {featured.map((tool) => (

            <a
              href={tool.url}
              class="tool-card popular"
              data-search={`${tool.title} ${tool.description || ""}`}
            >

              <span class="tool-badge">
                HOT
              </span>

              {tool.icon && (
                <div class="tool-icon">
                  {tool.icon}
                </div>
              )}

              <h3>
                {tool.title}
              </h3>

              <p>
                {tool.description}
              </p>

              <span class="tool-action">
                Gunakan Tool →
              </span>

            </a>

          ))}

        </div>

      </section>

    )}


    <!-- ALL TOOLS -->
    <section class="tools-section">

      <h2 class="section-title">
        📂 Semua {categoryName} Tools
      </h2>

      <div
        id="toolsGrid"
        class="tools-grid"
      >

        {tools.map((tool) => (

          <a
            href={tool.url}
            class="tool-card"
            data-search={`${tool.title} ${tool.description || ""}`}
          >

            {tool.icon && (
              <div class="tool-icon">
                {tool.icon}
              </div>
            )}

            <h3>
              {tool.title}
            </h3>

            <p>
              {tool.description}
            </p>

            <span class="tool-action">
              Gunakan Tool →
            </span>

          </a>

        ))}

      </div>

    </section>


    <!-- EMPTY -->
    <div
      id="emptyState"
      class="tools-empty"
      hidden
    >
      <strong>
        Tool tidak ditemukan
      </strong>

      <p>
        Coba gunakan kata kunci pencarian lainnya.
      </p>
    </div>

  </main>


  <!-- SEARCH -->
  <script>
    const searchInput =
      document.querySelector("#toolSearch");

    const cards =
      document.querySelectorAll(
        ".tool-card"
      );

    const emptyState =
      document.querySelector(
        "#emptyState"
      );

    searchInput?.addEventListener(
      "input",
      () => {

        const query =
          searchInput.value
            .toLowerCase()
            .trim();

        let visible = 0;

        cards.forEach((card) => {

          const text =
            card.dataset.search ||
            card.textContent ||
            "";

          const match =
            text
              .toLowerCase()
              .includes(query);

          card.hidden = !match;

          if (match) {
            visible++;
          }

        });

        if (emptyState) {
          emptyState.hidden =
            visible !== 0;
        }

      }
    );
  </script>


  <!-- SEO JSON-LD -->
  <script type="application/ld+json">
    {JSON.stringify(jsonLd)}
  </script>

</MainLayout>



