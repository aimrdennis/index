---
import MainLayout from "../layouts/MainLayout.astro";
import { SITE } from "../lib/site";
import { getCollection } from "astro:content";

import "../styles/home.css";


/* =================================
   CONTENT COLLECTIONS
================================= */

const posts = await getCollection("blog");
const tools = await getCollection("tools");
const products = await getCollection("product");


/* =================================
   LATEST ARTICLES
================================= */

const latestPosts = [...posts]
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() -
      new Date(a.data.pubDate).getTime()
  )
  .slice(0, 3);


/* =================================
   POPULAR TOOLS
================================= */

const popularTools =
  tools.filter((tool) => tool.data.popular).length > 0
    ? tools
        .filter((tool) => tool.data.popular)
        .slice(0, 3)
    : tools.slice(0, 3);


/* =================================
   POPULAR PRODUCTS
================================= */

const popularProducts =
  products.filter((product) => product.data.popular).length > 0
    ? products
        .filter((product) => product.data.popular)
        .slice(0, 3)
    : products.slice(0, 3);


/* =================================
   SEO
================================= */

const pageTitle =
  "AI Mr Dennis | AI Mr Ferdy — Ekosistem Teknologi AI";

const pageDescription =
  "AI Mr Dennis adalah ekosistem teknologi AI independen yang dibangun oleh pengembang AI Mr Ferdy. Kami membuat berbagai tools AI, software, produk digital, dan eksperimen teknologi yang berfokus pada masalah nyata, dengan pengalaman yang sederhana dan mudah digunakan.";
---


<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={SITE.url()}
  isHome={true}
>


  <!-- =================================
       HERO
  ================================== -->

  <section class="hero">

    <div class="hero-container">


      <!-- HERO CONTENT -->

