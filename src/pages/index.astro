              >


                <div class="blog-card-image">

                  <img
                    src={SITE.url(`/api/og/${post.slug}.svg`)}
                    alt={post.data.title}
                    loading="lazy"
                    width="1200"
                    height="630"
                  />

                </div>


                <div class="blog-card-content">

                  <div class="blog-card-meta">
                    {post.data.pubDate}
                  </div>


                  <h3>
                    {post.data.title}
                  </h3>


                  {
                    post.data.description && (

                      <p>
                        {post.data.description}
