---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE } from '../lib/site';

const pageTitle =
  'Ai Mr Dennis - Link, Tools, AI & Digital Creator';

const pageDescription =
  'Bio resmi Ai Mr Dennis untuk akses cepat ke tools, website, AI, social media, tutorial digital, SEO, automation, dan berbagai project modern.';
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={SITE.url()}
>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">

        <div class="hero-left">

          <div class="hero-tag">
            OFFICIAL BIO PAGE
          </div>

          <h1>
            Ai Mr Dennis
          </h1>

          <p>
            Teknologi, AI, SEO, automation, tools digital modern dan berbagai project internet yang dibangun untuk performa cepat, clean dan modern.
          </p>

          <div class="hero-btns">
            <a href="https://aimrdennis.com" class="btn btn-primary">
              Official Website
            </a>

            <a href="https://news.aimrdennis.com" class="btn btn-secondary">
              Latest Articles
            </a>
          </div>

        </div>

        <div class="hero-right">

          <div class="hero-card">
            <div class="hero-badge">
              AI & SEO
            </div>

            <h3>
              Modern Digital
            </h3>

            <p>
              AI tools, SEO systems, automation dan berbagai solusi digital modern.
            </p>
          </div>

          <div class="hero-card">
            <div class="hero-badge">
              PERFORMANCE
            </div>

            <h3>
              Ultra Fast
            </h3>

            <p>
              Dibangun ringan, mobile first, clean UI dan optimized untuk user modern.
            </p>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- LINKS -->
  <section class="section">
    <div class="container">

      <h2 class="section-title">
        Main Links
      </h2>

      <p class="section-desc">
        Semua akses utama Ai Mr Dennis dalam satu halaman.
      </p>

      <div class="pricing">

        <div class="price-card">
          <h3>Official Website</h3>

          <p>
            Website utama Ai Mr Dennis.
          </p>

          <a
            href="https://aimrdennis.com"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            Visit Website
          </a>
        </div>

        <div class="price-card">
          <h3>News & Articles</h3>

          <p>
            Artikel AI, SEO, teknologi dan digital modern terbaru.
          </p>

          <a
            href="https://news.aimrdennis.com"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            Open News
          </a>
        </div>

        <div class="price-card">
          <h3>Tools</h3>

          <p>
            Kumpulan tools digital modern dan utility online.
          </p>

          <a
            href="https://tools.aimrdennis.com"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            Open Tools
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- FEATURES -->
  <section class="section">
    <div class="container">

      <h2 class="section-title">
        What I Build
      </h2>

      <p class="section-desc">
        Fokus pada teknologi modern dan digital ecosystem.
      </p>

      <div class="features">

        <div class="feature-card">
          <h3>AI Projects</h3>

          <p>
            AI tools, automation system dan smart digital workflow.
          </p>
        </div>

        <div class="feature-card">
          <h3>SEO Systems</h3>

          <p>
            Website cepat, optimized dan scalable untuk search engine modern.
          </p>
        </div>

        <div class="feature-card">
          <h3>Modern UI</h3>

          <p>
            Minimal clean interface dengan performa ultra ringan.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- SOCIAL -->
  <section class="section">
    <div class="container">

      <h2 class="section-title">
        Social & Community
      </h2>

      <p class="section-desc">
        Follow dan terhubung dengan Ai Mr Dennis.
      </p>

      <div class="pricing">

        <div class="price-card">
          <h3>Instagram</h3>

          <p>
            Update konten dan project terbaru.
          </p>

          <a
            href="#"
            class="btn btn-primary"
          >
            Follow
          </a>
        </div>

        <div class="price-card">
          <h3>YouTube</h3>

          <p>
            Tutorial teknologi, AI dan digital modern.
          </p>

          <a
            href="#"
            class="btn btn-primary"
          >
            Subscribe
          </a>
        </div>

        <div class="price-card">
          <h3>Telegram</h3>

          <p>
            Community, update dan informasi terbaru.
          </p>

          <a
            href="#"
            class="btn btn-primary"
          >
            Join Now
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">

      <h2 class="section-title">
        FAQ
      </h2>

      <p class="section-desc">
        Pertanyaan umum tentang Ai Mr Dennis.
      </p>

      <div class="faq-item">
        <div class="faq-question">
          <span>Apa itu Ai Mr Dennis?</span>
          <div class="faq-icon"></div>
        </div>

        <div class="faq-answer">
          <p>
            Platform dan creator digital yang fokus pada AI, SEO, automation dan teknologi modern.
          </p>
        </div>
      </div>

      <div class="faq-item">
        <div class="faq-question">
          <span>Apakah website mobile friendly?</span>
          <div class="faq-icon"></div>
        </div>

        <div class="faq-answer">
          <p>
            Ya, seluruh system dibangun mobile first dan optimized untuk performa cepat.
          </p>
        </div>
      </div>

      <div class="faq-item">
        <div class="faq-question">
          <span>Apakah tersedia tools online?</span>
          <div class="faq-icon"></div>
        </div>

        <div class="faq-answer">
          <p>
            Ya, tersedia berbagai tools digital dan utility modern yang terus dikembangkan.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container">

      <h2>
        Explore The Digital Ecosystem
      </h2>

      <p>
        AI, SEO, tools digital, automation dan project modern dalam satu ekosistem.
      </p>

      <a
        href="https://aimrdennis.com"
        class="btn btn-primary"
      >
        Visit Now
      </a>

    </div>
  </section>

</MainLayout>
