      </div>

    </div>

  </section>



  <!-- =================================
       POPULAR TOOLS
  ================================== -->

  <section class="section">

    <div class="container-page">

      <div class="section-heading">

        <span class="section-label">
          AI Tools
        </span>

        <h2 class="section-title">
          AI Tools Pilihan
        </h2>

        <p class="section-desc">
          Beberapa tools yang dapat membantu pekerjaan
          digital menjadi lebih praktis dan efisien.
        </p>

      </div>


      <div class="blog-grid">

        {
          popularTools.map((tool) => (

            <article class="blog-card">

              <a
                href={`/tools/${tool.slug}/`}
                class="blog-card-link"
              >


                <div class="blog-card-image">

                  <img
                    src={SITE.url(`/api/og/${tool.slug}.svg`)}
                    alt={tool.data.title}
                    loading="lazy"
                    width="1200"
                    height="630"
                  />

                </div>


                <div class="blog-card-content">

                  <span class="card-label">
                    AI Tool
                  </span>


                  <h3>
                    {tool.data.title}
                  </h3>


                  {
                    tool.data.description && (

                      <p>
                        {tool.data.description}
                      </p>

                    )
                  }


                  <span class="readmore">
                    Buka Tool →
                  </span>

                </div>


              </a>

            </article>

          ))
        }

      </div>

    </div>

  </section>



  <!-- =================================
       LATEST ARTICLES
  ================================== -->

  <section class="section">

    <div class="container-page">

      <div class="section-heading">

        <span class="section-label">
          Blog
        </span>

        <h2 class="section-title">
          Artikel Terbaru
        </h2>

        <p class="section-desc">
          Pembahasan terbaru mengenai AI, SEO,
          teknologi, dan perkembangan dunia digital.
        </p>

      </div>


      <div class="blog-grid">

        {
          latestPosts.map((post) => (

            <article class="blog-card">

              <a
                href={`/blog/${post.slug}/`}
